# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
# Replace with your Supabase Project URL & Service Role Key from Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Set to true only to use the built-in in-memory data store for local development.
USE_MOCK_DB=false

# JWT Authentication
JWT_SECRET=teen_spend_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
